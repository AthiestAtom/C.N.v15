# remote | local
CHANDIGARH_MODEL_MODE=remote

# Base URL of a running CITYNEXUS mobility-model API.
CHANDIGARH_MODEL_URL=http://localhost:8000
CITYNEXUS_MODEL_PROJECT=
CITYNEXUS_MODEL_CITY=chandigarh

# Polling of CITYNEXUS asynchronous simulations.
CHANDIGARH_MODEL_POLL_TIMEOUT=300
CHANDIGARH_MODEL_POLL_INTERVAL=2
